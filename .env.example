# Copy to .env and fill in real values. Never commit .env.

# MLflow tracking server (use file:./mlruns for local runs without a server)
MLFLOW_TRACKING_URI=http://localhost:5000

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Kafka streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=fraud-transactions

# DVC remote (MinIO / S3). Credentials are read by DVC/boto3 from the
# environment; do not put them in .dvc/config.
AWS_ACCESS_KEY_ID=<your-access-key>
AWS_SECRET_ACCESS_KEY=<your-secret-key>
# DVC remote endpoint override for a self-hosted MinIO (leave unset for real S3).
# The Retrain and Model Monitoring workflows read this as a repository secret to
# point the DVC remote at the object store before pulling the dataset.
DVC_REMOTE_ENDPOINT=http://localhost:9000

# MinIO object store (S3-compatible). No default is baked into the code, so
# these must be set for any environment that talks to MinIO.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>

# Model registry promotion floor and drift retrain threshold (percent of
# features drifted above which retraining is recommended).
MODEL_PROMOTION_MIN_AUC=0.90
DRIFT_RETRAIN_PCT=30.0

# Kaggle API credentials for scripts/setup_data.py (real dataset download).
# Alternatively place a kaggle.json in ~/.kaggle/.
KAGGLE_USERNAME=<your-kaggle-username>
KAGGLE_KEY=<your-kaggle-key>
